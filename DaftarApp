
name: Build DaftarApp APK

on:
  workflow_dispatch:
  push:
    paths:
      - 'DaftarApp-Android-Project-GitHub-Build.zip'

jobs:
  build:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: '21'

      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      - name: Extract project
        run: |
          sudo apt-get update
          sudo apt-get install -y unzip
          unzip -o DaftarApp-Android-Project-GitHub-Build.zip -d project
          cd project
          find . -name package.json -print

      - name: Build APK
        run: |
          cd project
          PROJECT_DIR=$(find . -name package.json -not -path '*/node_modules/*' | head -1 | xargs dirname)
          cd "$PROJECT_DIR"
          npm install
          npm install @capacitor/android
          npx cap add android
          npx cap sync android
          cd android
          chmod +x gradlew
          ./gradlew assembleDebug

      - name: Upload APK
        uses: actions/upload-artifact@v4
        with:
          name: DaftarApp-APK
          path: project/**/android/app/build/outputs/apk/debug/app-debug.apk
          
